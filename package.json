{
  "name": "@huberyyang/todo-utils",
  "type": "module",
  "version": "1.0.0-beta.1",
  "packageManager": "pnpm@11.0.7",
  "description": "⚡️A useful utils function library, very fast",
  "author": "HuberyYang",
  "license": "MIT",
  "homepage": "https://github.com/Hub-yang/todo-utils",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hub-yang/todo-utils.git"
  },
  "bugs": {
    "url": "https://github.com/Hub-yang/todo-utils/issues"
  },
  "keywords": [
    "utils",
    "typescript",
    "library"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@huberyyang/todo-scripts": "latest",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
